# SPDX-License-Identifier: Apache-2.0
#
# realorrug-serve as a systemd *user* unit for guardian, beside radar-serve.
#
# Why a user unit and not ../realorrug-serve.service: installing a system unit
# needs sudo with a password, and the box's passwordless sudo belongs to other
# services. guardian has lingering enabled, so this unit is supervised by
# guardian's systemd manager, starts at boot, and survives logout -- unlike a
# process started by hand over SSH. The system unit stays the target once the
# owner installs it with sudo; this file is the no-sudo way to run the same
# binary with the same environment.
#
# Install (as guardian, no sudo):
#   install -D -m 0755 realorrug-serve ~/realorrug/bin/realorrug-serve
#   install -D -m 0644 realorrug-serve.service ~/.config/systemd/user/realorrug-serve.service
#   systemctl --user daemon-reload && systemctl --user enable --now realorrug-serve
# Remove:
#   systemctl --user disable --now realorrug-serve
[Unit]
Description=realorrug public documents (user unit) — stats, leaderboard, weeks, hunters, pool
Documentation=https://github.com/1xmint/realorrug
After=network-online.target

[Service]
Type=simple
# The base-rate and population files are read relative to this directory: dated
# copies under docs/research/data/, placed there when realorrug left Radar's
# folders (ADR 0026, deploy/README.md).
WorkingDirectory=/home/guardian/realorrug
ExecStart=/home/guardian/realorrug/bin/realorrug-serve
Environment=REALORRUG_BIND=127.0.0.1:8090
Environment=REALORRUG_CONTEST_DIR=/home/guardian/realorrug/data/contest
Environment=REALORRUG_ANALYST_DIR=/home/guardian/realorrug/data/analyst
# The same origin radar-serve sends today, from its own env file in Radar.
Environment=REALORRUG_SITE_ORIGIN=https://cabalhunter.org
# Sign-in and forecast routes (design 0032 s11). Every name below is read from
# a line in this unit or an EnvironmentFile; a missing one closes that feature, it never opens it:
#   REALORRUG_STORE_PATH          the SQLite file (default journal mode, no WAL)
#   REALORRUG_X_CLIENT_ID         the test X app's OAuth2 client id
#   REALORRUG_X_REDIRECT_URI      the callback the X app lists
#   REALORRUG_X_CLIENT_SECRET     optional; only for a confidential X app
#   REALORRUG_MONTHLY_USD         the whole monthly ceiling; unset = closed
#   REALORRUG_FIXED_MONTHLY_USD   the fixed part of it; unset = closed
#   REALORRUG_SERVE_MONTHLY_USD   serve's slice, at most ceiling minus fixed; unset or over = closed
#   REALORRUG_APP_ORIGINS         exact origins allowed credentialed CORS; unset = no header
#   REALORRUG_ROUNDS_FILE         the round record (id, close, coins with q_basis_points); unset or a coin without odds = 503
#   REALORRUG_TRUST_CLOUDFLARE    1 to key the rate limit on CF-Connecting-IP
Restart=always
RestartSec=10
NoNewPrivileges=true
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=default.target
