# SPDX-License-Identifier: Apache-2.0
#
# The public site's documents. Read-only: it reads the contest ledger, the reply
# log, the base rates and the population summary, and writes nothing.
[Unit]
Description=realorrug public documents — stats, leaderboard, weeks, hunters, pool
Documentation=https://github.com/1xmint/realorrug
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=guardian
Group=guardian
# The base-rate and population files are read relative to this directory: dated
# copies under docs/research/data/, placed there when realorrug left Radar's
# folders (ADR 0026, deploy/README.md).
WorkingDirectory=/home/guardian/realorrug
ExecStart=/usr/local/bin/realorrug-serve
Environment=REALORRUG_BIND=127.0.0.1:8090
Environment=REALORRUG_CONTEST_DIR=/home/guardian/realorrug/data/contest
Environment=REALORRUG_ANALYST_DIR=/home/guardian/realorrug/data/analyst
# Set to the site's origin to let a browser read these; unset sends no CORS header.
EnvironmentFile=-/etc/realorrug/serve.env
# Sign-in and forecast routes (design 0032 s11). Every name below is read from
# /etc/realorrug/serve.env; a missing one closes that feature, it never opens it:
#   REALORRUG_STORE_PATH          the SQLite file (default journal mode, no WAL)
#   REALORRUG_X_CLIENT_ID         the test X app's OAuth2 client id
#   REALORRUG_X_REDIRECT_URI      the callback the X app lists
#   REALORRUG_X_CLIENT_SECRET     optional; only for a confidential X app
#   REALORRUG_SERVE_MONTHLY_USD   the serve-owned monthly spending stop; unset = closed
#   REALORRUG_APP_ORIGINS         exact origins allowed credentialed CORS; unset = no header
#   REALORRUG_ROUNDS_FILE         the round record (id, close, coins); unset = 503
#   REALORRUG_TRUST_CLOUDFLARE    1 to key the rate limit on CF-Connecting-IP
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
# The store is the only thing serve writes. The leading "-" keeps the unit
# starting on a box with no store directory yet, which leaves sign-in closed.
ReadWritePaths=-/home/guardian/realorrug/data/store
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
