# SPDX-License-Identifier: Apache-2.0
#
# Install to /etc/systemd/system/realorrug-payout.service. Started by the timer.
#
# The payout: for each claimed, unpaid week, claims the creator fees from the
# Pons v2 fee escrow on Robinhood Chain, pays exactly what the escrow paid to
# the claimed address, and reads both transactions back before the ledger says
# paid (ADR 0025, ADR 0013). DO NOT ENABLE THE TIMER UNTIL LAUNCH.
#
# Its own user and its own unit. The wallet key is in Turnkey and cannot be
# copied out; what the box holds is a Turnkey API key, readable by
# realorrug-payout and nobody else, whose policy lets it ask for two things on
# chain 4663 and nothing more: claim() on the escrow, and a plain ETH transfer.
# Revoking that API key in Turnkey's dashboard stops the payout.
#
# Network: the Robinhood Chain RPC endpoint and api.turnkey.com, over HTTPS, and
# nothing else. systemd cannot allow hosts by name; RestrictAddressFamilies below
# limits it to IP sockets, and a host-level egress rule for this user is the
# place to pin the two hosts if the box has one. It reads no store, holds no
# tokens (ADR 0013 constraint 2), and writes only the contest directory: the
# week's record, the pool reading, a pending file while a payout is in flight,
# and its lock.
#
#   bash deploy/make-payout-key.sh    # the user, and /etc/realorrug/turnkey.key
#   sudo install -m 0640 -o root -g realorrug-payout deploy/payout.env.example /etc/realorrug/payout.env
#   sudo setfacl -m u:realorrug-payout:rwx /home/guardian/radar/data/contest
[Unit]
Description=realorrug payout — claims the week's prize from the escrow and pays it, signed through Turnkey
Documentation=https://github.com/1xmint/realorrug
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=realorrug-payout
Group=realorrug-payout
WorkingDirectory=/home/guardian/radar
ExecStart=/usr/local/bin/realorrug-payout --due
Environment=TURNKEY_API_KEY=/etc/realorrug/turnkey.key
Environment=RADAR_CONTEST_DIR=/home/guardian/radar/data/contest
EnvironmentFile=/etc/realorrug/payout.env

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/guardian/radar/data/contest
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=16
